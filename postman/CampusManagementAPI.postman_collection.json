{
  "info": {
    "_postman_id": "9ef5e2e3-2a3e-4a34-a6b5-6e975037a480",
    "name": "Campus Management API",
    "description": "Capstone API workflows and core success, validation, missing-resource, and authorization checks. Set adminEmail/adminPassword before running Login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "adminEmail", "value": "admin@campus.local" },
    { "key": "adminPassword", "value": "" },
    { "key": "studentEmail", "value": "asha.student@example.test" },
    { "key": "studentPassword", "value": "ChangeMe123!" },
    { "key": "facultyEmail", "value": "ravi.faculty@example.test" },
    { "key": "facultyPassword", "value": "ChangeMe123!" },
    { "key": "accessToken", "value": "" },
    { "key": "studentAccessToken", "value": "" },
    { "key": "courseId", "value": "000000000000000000000000" },
    { "key": "courseCode", "value": "CS101" },
    { "key": "sectionId", "value": "000000000000000000000000" },
    { "key": "sectionCode", "value": "A" },
    { "key": "attendanceId", "value": "000000000000000000000000" },
    { "key": "announcementId", "value": "000000000000000000000000" },
    { "key": "studentId", "value": "000000000000000000000000" },
    { "key": "enrollmentId", "value": "000000000000000000000000" }
  ],
  "item": [
    {
      "name": "00 · Service",
      "item": [
        {
          "name": "Health check",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/health" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('API is healthy', function () { pm.response.to.have.status(200); });"] } }]
        }
      ]
    },
    {
      "name": "01 · Authentication",
      "item": [
        {
          "name": "Login · admin",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["const runId = Date.now().toString();", "const suffix = runId.slice(-6);", "pm.collectionVariables.set('studentEmail', `asha.${runId}@example.test`);", "pm.collectionVariables.set('facultyEmail', `ravi.${runId}@example.test`);", "pm.collectionVariables.set('studentId', `STU-${suffix}`);", "pm.collectionVariables.set('courseCode', `CS${suffix}`);", "pm.collectionVariables.set('sectionCode', `S${suffix.slice(-3)}`);"] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Login succeeds', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "if (body.success && body.data.accessToken) pm.collectionVariables.set('accessToken', body.data.accessToken);"] } }
          ]
        },
        {
          "name": "Current profile",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "method": "GET", "header": [], "url": "{{baseUrl}}/api/auth/me" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Profile is returned', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "Unauthorized · profile without token",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/auth/me" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Missing token is rejected', function () { pm.response.to.have.status(401); });"] } }]
        }
      ]
    },
    {
      "name": "02 · Users and courses",
      "item": [
        {
          "name": "Create student · admin",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Asha Student\",\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\",\n  \"role\": \"student\",\n  \"studentId\": \"{{studentId}}\",\n  \"department\": \"Computer Science\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/users" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Student account is created', function () { pm.response.to.have.status(201); });", "const body = pm.response.json();", "if (body.success && body.data.user?._id) pm.collectionVariables.set('studentId', body.data.user._id);"] } }]
        },
        {
          "name": "Login · student (after creating student)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/login" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Student login succeeds', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "if (body.success && body.data.accessToken) pm.collectionVariables.set('studentAccessToken', body.data.accessToken);"] } }]
        },
        {
          "name": "Create faculty · admin",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Ravi Faculty\",\n  \"email\": \"{{facultyEmail}}\",\n  \"password\": \"{{facultyPassword}}\",\n  \"role\": \"faculty\",\n  \"department\": \"Computer Science\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/users" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Faculty account is created', function () { pm.response.to.have.status(201); });", "const body = pm.response.json();", "if (body.success && body.data.user?._id) pm.collectionVariables.set('facultyId', body.data.user._id);"] } }]
        },
        {
          "name": "Login · faculty (after creating faculty)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{facultyEmail}}\",\n  \"password\": \"{{facultyPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/login" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Faculty login succeeds', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "if (body.success && body.data.accessToken) pm.collectionVariables.set('facultyAccessToken', body.data.accessToken);"] } }]
        },
        {
          "name": "List courses",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "method": "GET", "header": [], "url": "{{baseUrl}}/api/courses?page=1&limit=20" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Course list succeeds', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "Create course · admin",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"code\": \"{{courseCode}}\",\n  \"title\": \"Introduction to Computing\",\n  \"description\": \"Foundations of computing and problem solving\",\n  \"credits\": 3,\n  \"department\": \"Computer Science\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/courses" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Course is created', function () { pm.response.to.have.status(201); });", "const body = pm.response.json();", "if (body.success && body.data._id) pm.collectionVariables.set('courseId', body.data._id);"] } }]
        },
        {
          "name": "Validation failure · invalid course",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"code\": \"\",\n  \"title\": \"\",\n  \"credits\": 0,\n  \"department\": \"\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/courses" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Invalid course is rejected', function () { pm.response.to.have.status(400); });"] } }]
        },
        {
          "name": "Missing resource · course",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "method": "GET", "header": [], "url": "{{baseUrl}}/api/courses/000000000000000000000000" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Missing course returns 404', function () { pm.response.to.have.status(404); });"] } }]
        },
        {
          "name": "Role denied · student cannot create course",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{studentAccessToken}}", "type": "string" }] }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"code\": \"CS999\",\n  \"title\": \"Not Allowed\",\n  \"credits\": 3,\n  \"department\": \"Computer Science\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/courses" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Student is denied admin action', function () { pm.response.to.have.status(403); });"] } }]
        }
      ]
    },
    {
      "name": "03 · Sections and enrolment",
      "item": [
        {
          "name": "Create section · admin",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"course\": \"{{courseId}}\",\n  \"term\": \"Fall 2026\",\n  \"sectionCode\": \"{{sectionCode}}\",\n  \"faculty\": \"{{facultyId}}\",\n  \"capacity\": 40\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/sections" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Section is created', function () { pm.response.to.have.status(201); });", "const body = pm.response.json();", "if (body.success && body.data._id) pm.collectionVariables.set('sectionId', body.data._id);"] } }]
        },
        {
          "name": "Enrol student · admin",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"student\": \"{{studentId}}\",\n  \"section\": \"{{sectionId}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/enrollments" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Student is enrolled', function () { pm.expect([200, 201]).to.include(pm.response.code); });", "const body = pm.response.json();", "if (body.success && body.data._id) pm.collectionVariables.set('enrollmentId', body.data._id);"] } }]
        },
        {
          "name": "List enrolments · admin",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "method": "GET", "header": [], "url": "{{baseUrl}}/api/enrollments?page=1&limit=20" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Enrolments are listed', function () { pm.response.to.have.status(200); });"] } }]
        }
      ]
    },
    {
      "name": "04 · Attendance and announcements",
      "item": [
        {
          "name": "Mark attendance · assigned faculty",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{facultyAccessToken}}", "type": "string" }] }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"section\": \"{{sectionId}}\",\n  \"sessionDate\": \"2026-11-14\",\n  \"records\": [\n    { \"student\": \"{{studentId}}\", \"status\": \"present\" }\n  ]\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/attendance" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Attendance is saved', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "List attendance · assigned faculty",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{facultyAccessToken}}", "type": "string" }] }, "method": "GET", "header": [], "url": "{{baseUrl}}/api/attendance/sections/{{sectionId}}?date=2026-11-14" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Section attendance is returned', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "if (body.success && body.data[0]?._id) pm.collectionVariables.set('attendanceId', body.data[0]._id);"] } }]
        },
        {
          "name": "Correct attendance · assigned faculty",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{facultyAccessToken}}", "type": "string" }] }, "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"late\",\n  \"note\": \"Arrived after class began\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/attendance/{{attendanceId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Attendance correction succeeds', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "Attendance report · assigned faculty",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{facultyAccessToken}}", "type": "string" }] }, "method": "GET", "header": [], "url": "{{baseUrl}}/api/attendance/reports/sections/{{sectionId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Attendance report is returned', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "Post campus announcement · admin",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Welcome to the new term\",\n  \"body\": \"Classes begin Monday. Please check your section timetable.\",\n  \"scope\": \"campus\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/announcements" },
            "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Announcement is published', function () { pm.response.to.have.status(201); });", "const body = pm.response.json();", "if (body.success && body.data._id) pm.collectionVariables.set('announcementId', body.data._id);"] } }]
        },
        {
          "name": "Post section announcement · assigned faculty",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{facultyAccessToken}}", "type": "string" }] }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Section A materials\",\n  \"body\": \"The reading list is available in the course portal.\",\n  \"scope\": \"section\",\n  \"section\": \"{{sectionId}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/announcements" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Faculty can post to assigned section', function () { pm.response.to.have.status(201); });"] } }]
        },
        {
          "name": "List announcements · signed in",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "method": "GET", "header": [], "url": "{{baseUrl}}/api/announcements" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Announcements are listed', function () { pm.response.to.have.status(200); });"] } }]
          },
          {
            "name": "Read announcement · admin",
            "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "method": "GET", "header": [], "url": "{{baseUrl}}/api/announcements/{{announcementId}}" },
            "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Announcement can be retrieved', function () { pm.response.to.have.status(200); });"] } }]
          },
          {
            "name": "Edit announcement · admin",
            "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated campus notice\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/announcements/{{announcementId}}" },
            "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Announcement can be edited', function () { pm.response.to.have.status(200); });"] } }]
          },
          {
            "name": "Archive announcement · admin",
            "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/announcements/{{announcementId}}" },
            "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Announcement can be archived', function () { pm.response.to.have.status(200); });"] } }]
        }
      ]
    }
  ]
}
